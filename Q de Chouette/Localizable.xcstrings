        }
      }
    },
    "%@ peut aussi siroter : relancer le dernier dé en espérant un %lld. Réussi, c'est un cul de chouette ; raté, la chouette est perdue." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ may also sip (sirotage): reroll the last die hoping for a %2$lld. Success makes a cul de chouette; failure loses the chouette."
          }
        }
      }
    },
    "%@ peut siroter sa chouette de %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ may sip their chouette of %2$lld"
          }
        }
      }
    },
    "%@ relève le défi de %@ : il lui faut « %@ »." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ takes up %2$@’s challenge and needs “%3$@”."
          }
        }
      }
    },
    "%@ remporte %lld points !" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

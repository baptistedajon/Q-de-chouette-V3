    "%@ gagne une grelottine" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ earns a grelottine"
          }
        }
      }
    },
    "%@ joue un civet de %lld sur « %@ »" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bets a civet of %2$lld on “%3$@”"
          }
        }
      }
    },
    "%@ n'ont pas tapé à temps et perdent %lld points chacun." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ didn't tap in time and lose %2$lld points each."

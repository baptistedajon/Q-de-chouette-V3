    "%lld" : {
      "shouldTranslate" : false
    },
    "%lld – %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld – %2$@"
          }
        }
      }
    },
    "%lld + %lld = %lld : la somme de deux dés donne le troisième, c'est une velute. Elle rapporte deux fois le carré du grand dé : %@ %@ pour %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld + %2$lld = %3$lld: two dice add up to the third, that's a velute. It scores twice the square of the highest die: %4$@ %5$@ for %6$@."
          }
        }
      }
    },
    "%lld dé(s) reconnu(s) sur %lld. Complétez en touchant les dés ci-dessous." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld dice recognized. Complete by tapping the dice below."
          }
        }
      }
    },
    "%lld et %lld font une chouette, et %lld + %lld = %lld fait une velute ! Dans ce cas, tout le monde peut gagner : le premier qui tape sa zone en criant « Pas mou le caillou ! » remporte %@ %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld and %2$lld make a chouette, and %3$lld + %4$lld = %5$lld makes a velute! Now anyone can win: the first to tap their zone shouting “Pas mou le caillou !” takes %6$@ %7$@."
          }
        }
      }
    },
    "%lld ms" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

    "Sirotage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirotage"
          }
        }
      }
    },
    "Sirotage : après une chouette, relancer le dernier dé pour tenter le cul de chouette. Bévue : taper avant le signal coûte des points. Civet : parier sur son prochain lancer. Grelottine : gagnée sur un néant, permet de défier un joueur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirotage: after a chouette, reroll the last die to try for a cul de chouette. Bévue: tapping before the signal costs points. Civet: bet on your next roll. Grelottine: earned on a néant, lets you challenge a player."
          }
        }
      }
    },
    "Sirotage raté" : {
      "localizations" : {

    },
    "Trois dés identiques : le fameux cul de chouette ! %@ %@ pour %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three matching dice: the famous cul de chouette! %1$@ %2$@ for %3$@."
          }
        }
      }
    },
    "Trois dés identiques. Le lanceur marque %lld points, plus %lld fois la valeur du dé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three matching dice. The roller scores %1$lld points plus %2$lld times the die value."
          }
        }
      }
    },
    "Trois valeurs qui se suivent. Tous les joueurs tapent leur zone en criant « Grelotte ça picote ! » : le plus lent perd %lld points." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three consecutive values. Every player taps their zone shouting “Grelotte ça picote !”: the slowest loses %lld points."
          }
        }
      }
    },

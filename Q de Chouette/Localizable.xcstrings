    },
    "%lld tours · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld turns · %2$@"
          }
        }
      }
    },
    "%lld, %lld, %lld se suivent : c'est une suite. Tout le monde doit taper sa zone en criant « Grelotte ça picote ! » dès le signal. Le plus lent perd %lld points." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld, %2$lld, %3$lld follow each other: that's a suite. Everyone must tap their zone shouting “Grelotte ça picote !” at the signal. The slowest loses %4$lld points."
          }
        }
      }
    },
    "%lld. %@, %lld points sur %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld. %2$@, %3$lld points out of %4$lld"
